{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-pdf-viewer.mjs",
    "prebuild": "node scripts/prepare-pdf-viewer.mjs",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:mock-auth": "tsx --conditions=react-server --test tests/server/*.test.ts",
    "test:e2e": "playwright test",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "test:admin-performance": "playwright test --config playwright.admin-performance.config.ts",
    "test:backend": "playwright test --config playwright.backend.config.ts",
    "build:cv-renderer": "node scripts/build-cv-renderer.mjs",
    "test:cv-renderer": "tsx --test tests/resume-renderer.test.mts",
    "test:cv-preview": "tsx --test tests/resume-preview.test.mts",
    "test:cv-lifecycle": "node --test tests/resume-editor-activity.test.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "laravel-echo": "^2.6.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.2",
    "pdfjs-dist": "6.4.299",
    "pusher-js": "^8.6.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "fast-glob": "^3.3.3",
    "micromatch": "^4.0.8",
    "braces": "^3.0.3"
  }
}
